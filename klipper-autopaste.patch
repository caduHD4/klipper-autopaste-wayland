+bool Klipper::isAutoPasteSupported() const
+{
+    return KWindowSystem::isPlatformWayland();
+}
+
+bool Klipper::isAutoPasteInjectReady() const
+{
+    return KWindowSystem::isPlatformWayland() && m_fakeInput && m_fakeInput->isValid() &&
+        m_windowManagement && m_windowManagement->isValid();
+}
+
+void Klipper::slotHistoryMenuEntryActivated(const QString &uuid)
+{
+    if (!m_bAutoPaste || !isAutoPasteInjectReady()) {
+        return;
+    }
+    if (m_clip->isLocked(QClipboard::Selection) || m_clip->isLocked(QClipboard::Clipboard)) {
+        return;
+    }
+    m_pendingAutoPasteAfterHistorySelection = true;
+    m_pendingAutoPasteClipboardReady = false;
+    m_pendingAutoPasteFocusRestored = false;
+    m_pendingAutoPasteUuid = uuid;
+    const auto generation = m_autoPasteGeneration;
+    QTimer::singleShot(2000, this, [this, generation] {
+        if (generation == m_autoPasteGeneration && m_pendingAutoPasteAfterHistorySelection) {
+            qCWarning(KLIPPER_LOG) << "Auto-paste cancelled: clipboard/focus confirmation timed out";
+            clearClipboardPopupAutoPastePending();
+        }
+    });
+}
+
+void Klipper::clearClipboardPopupAutoPastePending()
+{
+    ++m_autoPasteGeneration;
+    m_autoPasteTarget.clear();
+    m_autoPasteTargetWasWindow = false;
+    m_pendingAutoPasteAfterHistorySelection = false;
+    m_pendingAutoPasteClipboardReady = false;
+    m_pendingAutoPasteFocusRestored = false;
+    m_pendingAutoPasteUuid.clear();
+}
+
+void Klipper::onClipboardPopupHiddenForAutoPaste()
+{
+    if (!m_pendingAutoPasteAfterHistorySelection || !m_bAutoPaste) return;
+    const auto generation = m_autoPasteGeneration;
+    // Qt can retain focusWindow() after its popup is hidden. A compositor ACK
+    // of the unmap is the reliable boundary before restoring external focus.
+    QTimer::singleShot(0, this, [this, generation] {
+        if (generation != m_autoPasteGeneration || m_popup->isVisible()) return;
+        if (!KlipperAutoPaste::afterWaylandSync(this, [this, generation] {
+            if (generation != m_autoPasteGeneration || m_popup->isVisible() ||
+                !m_pendingAutoPasteAfterHistorySelection) return;
+            if (m_autoPasteTargetWasWindow && !m_autoPasteTarget) {
+                clearClipboardPopupAutoPastePending();
+                return;
+            }
+            m_pendingAutoPasteFocusRestored = true;
+            if (m_autoPasteTarget && m_windowManagement &&
+                m_windowManagement->activeWindow() != m_autoPasteTarget) {
+                m_autoPasteTarget->requestActivate();
+            }
+            tryAutoPasteHistorySelection();
+        })) clearClipboardPopupAutoPastePending();
+    });
+}
+
+bool Klipper::isAutoPasteDestinationActive() const
+{
+    if (!m_windowManagement || !m_windowManagement->isValid()) return false;
+    auto *active = m_windowManagement->activeWindow();
+    return m_autoPasteTargetWasWindow ? m_autoPasteTarget && active == m_autoPasteTarget : !active;
+}
+
+void Klipper::tryAutoPasteHistorySelection()
+{
+    if (!m_pendingAutoPasteAfterHistorySelection || !m_pendingAutoPasteClipboardReady ||
+        !m_pendingAutoPasteFocusRestored || m_popup->isVisible()) return;
+    if (!isAutoPasteDestinationActive()) return;
+    // The hide ACK and clipboard job can finish in either order. Send once,
+    // only while the exact original destination remains active.
+    const auto generation = m_autoPasteGeneration;
+    QTimer::singleShot(0, this, [this, generation] {
+        if (generation != m_autoPasteGeneration || !m_pendingAutoPasteAfterHistorySelection ||
+            !m_bAutoPaste || m_popup->isVisible()) return;
+        if (!isAutoPasteDestinationActive()) return;
+        if (m_clip->isLocked(QClipboard::Selection) || m_clip->isLocked(QClipboard::Clipboard)) return;
+        simulatePaste();
+        clearClipboardPopupAutoPastePending();
+    });
+}
+
+void Klipper::simulatePaste()
+{
+    if (!isAutoPasteInjectReady()) {
+        return;
+    }
+    if (!m_fakeInput || !m_fakeInput->isValid()) {
+        qCWarning(KLIPPER_LOG) << "Auto-paste unavailable: KWin FakeInput is not authenticated";
+        return;
+    }
+    KlipperAutoPaste::injectPasteShortcutWaylandFakeInput(
+        m_fakeInput, KlipperAutoPaste::pasteChordFromStandard());
+}
