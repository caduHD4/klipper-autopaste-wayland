+#include "autopastehelpers.h"
+
+#include <QKeyCombination>
+#include <QKeySequence>
+#include <QObject>
+#include <wayland-client-protocol.h>
+#include <KWayland/Client/connection_thread.h>
+#include <KWayland/Client/fakeinput.h>
+#include <linux/input-event-codes.h>
+#include <wayland-client-core.h>
+
+namespace KlipperAutoPaste
+{
+
+namespace {
+class DisplaySync final : public QObject
+{
+public:
+    explicit DisplaySync(QObject *owner, std::function<void()> done)
+        : QObject(owner), done(std::move(done)) {}
+    ~DisplaySync() override { if (callback) wl_callback_destroy(callback); }
+    wl_callback *callback = nullptr;
+    std::function<void()> done;
+    static void finished(void *data, wl_callback *, uint32_t)
+    {
+        auto *self = static_cast<DisplaySync *>(data);
+        auto done = std::move(self->done);
+        delete self;
+        done();
+    }
+};
+}
+
+bool afterWaylandSync(QObject *owner, std::function<void()> done)
+{
+    auto *connection = KWayland::Client::ConnectionThread::fromApplication();
+    if (!connection || !connection->display()) return false;
+    auto *sync = new DisplaySync(owner, std::move(done));
+    sync->callback = wl_display_sync(connection->display());
+    if (!sync->callback) { delete sync; return false; }
+    static const wl_callback_listener listener = {DisplaySync::finished};
+    wl_callback_add_listener(sync->callback, &listener, sync);
+    wl_display_flush(connection->display());
+    return true;
+}
+
+PasteChord pasteChordFromStandard()
+{
+    const QList<QKeySequence> bindings = QKeySequence::keyBindings(QKeySequence::Paste);
+    for (const QKeySequence &seq : bindings) {
+        if (seq.isEmpty()) {
+            continue;
+        }
+        const QKeyCombination combo = seq[0];
+        const Qt::Key key = combo.key();
+        if (key != Qt::Key_unknown && key != Qt::Key(0)) {
+            return {combo.keyboardModifiers(), key};
+        }
+    }
+    return {};
+}
+
+static int qtLatinKeyToEvdev(Qt::Key key)
+{
+    switch (key) {
+    case Qt::Key_A:
+        return KEY_A;
+    case Qt::Key_B:
+        return KEY_B;
+    case Qt::Key_C:
+        return KEY_C;
+    case Qt::Key_D:
+        return KEY_D;
+    case Qt::Key_E:
+        return KEY_E;
+    case Qt::Key_F:
+        return KEY_F;
+    case Qt::Key_G:
+        return KEY_G;
+    case Qt::Key_H:
+        return KEY_H;
+    case Qt::Key_I:
+        return KEY_I;
+    case Qt::Key_J:
+        return KEY_J;
+    case Qt::Key_K:
+        return KEY_K;
+    case Qt::Key_L:
+        return KEY_L;
+    case Qt::Key_M:
+        return KEY_M;
+    case Qt::Key_N:
+        return KEY_N;
+    case Qt::Key_O:
+        return KEY_O;
+    case Qt::Key_P:
+        return KEY_P;
+    case Qt::Key_Q:
+        return KEY_Q;
+    case Qt::Key_R:
+        return KEY_R;
+    case Qt::Key_S:
+        return KEY_S;
+    case Qt::Key_T:
+        return KEY_T;
+    case Qt::Key_U:
+        return KEY_U;
+    case Qt::Key_V:
+        return KEY_V;
+    case Qt::Key_W:
+        return KEY_W;
+    case Qt::Key_X:
+        return KEY_X;
+    case Qt::Key_Y:
+        return KEY_Y;
+    case Qt::Key_Z:
+        return KEY_Z;
+    default:
+        return KEY_V;
+    }
+}
+
+static void appendModifierEvdev(Qt::KeyboardModifiers modifiers, QList<int> *out)
+{
+    if (modifiers & Qt::MetaModifier) {
+        out->append(KEY_LEFTMETA);
+    }
+    if (modifiers & Qt::ControlModifier) {
+        out->append(KEY_LEFTCTRL);
+    }
+    if (modifiers & Qt::AltModifier) {
+        out->append(KEY_LEFTALT);
+    }
+    if (modifiers & Qt::ShiftModifier) {
+        out->append(KEY_LEFTSHIFT);
+    }
+}
+
+void injectPasteShortcutWaylandFakeInput(KWayland::Client::FakeInput *fakeInput, const PasteChord &chord)
+{
+    if (!fakeInput || !fakeInput->isValid()) {
+        return;
+    }
+
+    QList<int> modifiers;
+    appendModifierEvdev(chord.modifiers, &modifiers);
+    const int key = qtLatinKeyToEvdev(chord.key);
+
+    for (const int modifier : modifiers) {
+        fakeInput->requestKeyboardKeyPress(modifier);
+    }
+    fakeInput->requestKeyboardKeyPress(key);
+    fakeInput->requestKeyboardKeyRelease(key);
+    for (qsizetype i = modifiers.size() - 1; i >= 0; --i) {
+        fakeInput->requestKeyboardKeyRelease(modifiers.at(i));
+    }
+    if (auto *connection = KWayland::Client::ConnectionThread::fromApplication()) {
+        wl_display_flush(connection->display());
+    }
+}
+
+} // namespace KlipperAutoPaste
